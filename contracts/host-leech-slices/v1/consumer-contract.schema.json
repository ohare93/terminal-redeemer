{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal-redeemer.invalid/contracts/host-leech-slices/v1/consumer-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "protocol",
    "compatibility",
    "defaults",
    "selection",
    "authority",
    "drops",
    "revisions",
    "commands",
    "module",
    "configuration",
    "integration",
    "limitations",
    "rollout",
    "future_work"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "terminal-redeemer.host-leech-slices"
    },
    "contract_version": {
      "const": "1.3.0"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_schema_versions",
        "rpc_schema_versions",
        "controller_schema_versions",
        "workspace_normalization"
      ],
      "properties": {
        "inventory_schema_versions": {
          "const": [
            2
          ]
        },
        "rpc_schema_versions": {
          "const": [
            1
          ]
        },
        "controller_schema_versions": {
          "const": [
            2
          ]
        },
        "workspace_normalization": {
          "const": "unicode-nfkc-fold-v1"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "niri_version",
        "zellij_version",
        "topology"
      ],
      "properties": {
        "niri_version": {
          "const": "26.04"
        },
        "zellij_version": {
          "const": "0.44.3"
        },
        "topology": {
          "const": "one_active_output_or_coherent_zero_output_source"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leech_mode_enabled",
        "controller_enabled",
        "slice_clipboard_enabled",
        "authority_mode",
        "leech_write_authorized",
        "poll_interval",
        "control_timeout",
        "retry_window",
        "source_gone_grace",
        "source_gone_confirmations"
      ],
      "properties": {
        "leech_mode_enabled": {
          "const": false
        },
        "controller_enabled": {
          "const": false
        },
        "slice_clipboard_enabled": {
          "const": false
        },
        "authority_mode": {
          "const": "host_location"
        },
        "leech_write_authorized": {
          "const": false
        },
        "poll_interval": {
          "const": "2s"
        },
        "control_timeout": {
          "const": "5s"
        },
        "retry_window": {
          "const": "30s"
        },
        "source_gone_grace": {
          "const": "5s"
        },
        "source_gone_confirmations": {
          "const": 2
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "all_eligible_scope",
        "unnamed_spatial_policy",
        "routed_launch_policy",
        "all_eligible_state_field",
        "all_eligible_undoable",
        "prior_reader_behavior_when_enabled",
        "downgrade_requires_disable_first",
        "headless_workspace_policy"
      ],
      "properties": {
        "formula": {
          "const": "(all_eligible OR selected_workspace OR exact_pickup) AND NOT closed_by_user"
        },
        "all_eligible_scope": {
          "const": "current_and_future_eligible_sources_including_unnamed_workspaces"
        },
        "unnamed_spatial_policy": {
          "const": "attach_without_cross_machine_spatial_placement"
        },
        "routed_launch_policy": {
          "const": "explicit_selected_named_workspaces_only"
        },
        "all_eligible_state_field": {
          "const": "optional_omitempty_boolean"
        },
        "all_eligible_undoable": {
          "const": false
        },
        "prior_reader_behavior_when_enabled": {
          "const": "reject_unknown_field"
        },
        "downgrade_requires_disable_first": {
          "const": true
        },
        "headless_workspace_policy": {
          "const": "existing_exact_uniquely_normalized_named_workspace_only_no_creation"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_modes",
        "converged_properties",
        "local_supported_drift_policy",
        "order_policy",
        "leech_location_configurable",
        "host_spatial_writeback_available",
        "headless_observable_properties",
        "headless_omitted_property",
        "output_restoration_policy"
      ],
      "properties": {
        "supported_modes": {
          "const": [
            "host_location"
          ]
        },
        "converged_properties": {
          "const": [
            "workspace",
            "floating_or_tiled",
            "proportional_width",
            "proportional_height"
          ]
        },
        "local_supported_drift_policy": {
          "const": "revert_to_host"
        },
        "order_policy": {
          "const": "initial_best_effort_then_observation_only"
        },
        "leech_location_configurable": {
          "const": false
        },
        "host_spatial_writeback_available": {
          "const": false
        },
        "headless_observable_properties": {
          "const": [
            "workspace",
            "floating_or_tiled",
            "initial_order"
          ]
        },
        "headless_omitted_property": {
          "const": "proportional_size_until_output_returns"
        },
        "output_restoration_policy": {
          "const": "next_complete_revision_same_source_identity"
        }
      }
    },
    "drops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "survives_source_replacement",
        "survives_source_epoch_replacement",
        "survives_headless_while_session_live",
        "early_clear_operations",
        "automatic_expiry_requires",
        "non_authoritative_observations_do_not_advance"
      ],
      "properties": {
        "key": {
          "const": "exact_verified_zellij_session_id"
        },
        "survives_source_replacement": {
          "const": true
        },
        "survives_source_epoch_replacement": {
          "const": true
        },
        "survives_headless_while_session_live": {
          "const": true
        },
        "early_clear_operations": {
          "const": [
            "reopen",
            "undo"
          ]
        },
        "automatic_expiry_requires": {
          "const": [
            "accepted_higher_complete_revisions",
            "consecutive_confirmed_session_absence",
            "committed_grace_elapsed"
          ]
        },
        "non_authoritative_observations_do_not_advance": {
          "const": true
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_poll_advances_revision",
        "unchanged_semantics_still_advances_revision",
        "same_revision_same_semantics",
        "same_revision_different_semantics",
        "non_authoritative_observations"
      ],
      "properties": {
        "complete_poll_advances_revision": {
          "const": true
        },
        "unchanged_semantics_still_advances_revision": {
          "const": true
        },
        "same_revision_same_semantics": {
          "const": "idempotent_replay"
        },
        "same_revision_different_semantics": {
          "const": "conflict"
        },
        "non_authoritative_observations": {
          "const": [
            "degraded",
            "duplicate",
            "stale",
            "conflicting",
            "retired_epoch",
            "transport_disconnected"
          ]
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_init",
        "inventory_snapshot",
        "rpc",
        "launch",
        "launch_reconnect",
        "close_focused",
        "manage",
        "controller_init",
        "controller_run",
        "controller_status",
        "controller_operations",
        "mode_enable",
        "mode_disable",
        "mode_status",
        "legacy_attach"
      ],
      "properties": {
        "inventory_init": {
          "const": [
            "$REDEEM",
            "slice",
            "inventory",
            "init"
          ]
        },
        "inventory_snapshot": {
          "const": [
            "$REDEEM",
            "slice",
            "inventory",
            "snapshot",
            "--accept-schema-version",
            "2"
          ]
        },
        "rpc": {
          "const": [
            "$REDEEM",
            "slice",
            "rpc"
          ]
        },
        "launch": {
          "const": [
            "$REDEEM",
            "slice",
            "launch"
          ]
        },
        "launch_reconnect": {
          "const": [
            "$REDEEM",
            "slice",
            "launch",
            "--reconnect-token",
            "$TOKEN"
          ]
        },
        "close_focused": {
          "const": [
            "$REDEEM",
            "slice",
            "close-focused"
          ]
        },
        "manage": {
          "const": [
            "$REDEEM",
            "slice",
            "manage"
          ]
        },
        "controller_init": {
          "const": [
            "$REDEEM",
            "slice",
            "controller",
            "init"
          ]
        },
        "controller_run": {
          "const": [
            "$REDEEM",
            "slice",
            "controller",
            "run"
          ]
        },
        "controller_status": {
          "const": [
            "$REDEEM",
            "slice",
            "controller",
            "status"
          ]
        },
        "controller_operations": {
          "const": [
            "workspace-add",
            "workspace-remove",
            "all-enable",
            "all-disable",
            "pickup",
            "pickup-remove",
            "drop",
            "close",
            "reopen",
            "undo",
            "reconnect",
            "launch-handoff"
          ]
        },
        "mode_enable": {
          "const": [
            "$REDEEM",
            "slice",
            "mode",
            "enable"
          ]
        },
        "mode_disable": {
          "const": [
            "$REDEEM",
            "slice",
            "mode",
            "disable"
          ]
        },
        "mode_status": {
          "const": [
            "$REDEEM",
            "slice",
            "mode",
            "status"
          ]
        },
        "legacy_attach": {
          "const": [
            "$REDEEM",
            "mirror",
            "open",
            "--mode",
            "attach"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home_manager",
        "nixos",
        "package",
        "app",
        "contract_package",
        "contract_library"
      ],
      "properties": {
        "home_manager": {
          "const": "homeManagerModules.terminal-redeemer"
        },
        "nixos": {
          "const": "nixosModules.terminal-redeemer"
        },
        "package": {
          "const": "packages.x86_64-linux.terminal-redeemer"
        },
        "app": {
          "const": "apps.x86_64-linux.redeem"
        },
        "contract_package": {
          "const": "packages.x86_64-linux.host-leech-consumer-contract"
        },
        "contract_library": {
          "const": "lib.sliceConsumerContract"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "typed_options",
        "read_only_options",
        "unsupported_options"
      ],
      "properties": {
        "namespace": {
          "const": "programs.terminal-redeemer.slice"
        },
        "typed_options": {
          "const": [
            "leechMode.enable",
            "sourceHost",
            "selfCommand",
            "kittyCommand",
            "transportCommand",
            "transportOptions",
            "rpcCommand",
            "zellijCommand",
            "niriCommand",
            "systemctlCommand",
            "requestTimeout",
            "keepaliveInterval",
            "keepaliveCount",
            "retryMaxAttempts",
            "retryInitialBackoff",
            "retryMaxBackoff",
            "attachPrivateRoot",
            "attachShimCache",
            "controller.enable",
            "controller.hostID",
            "controller.leechID",
            "controller.pollInterval",
            "controller.controlTimeout",
            "controller.retryWindow",
            "controller.sourceGoneGrace",
            "controller.sourceGoneConfirmations"
          ]
        },
        "read_only_options": {
          "const": [
            "launchCommand",
            "closeFocusedCommand",
            "manageCommand",
            "niriIntegrationFragment",
            "clipboard.enabled"
          ]
        },
        "unsupported_options": {
          "const": [
            "controller.authorityMode",
            "controller.leechWriteAuthorized"
          ]
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_helper_option",
        "close_helper_option",
        "manage_helper_option",
        "generated_niri_option",
        "packaged_niri_path",
        "launch_binding",
        "close_binding",
        "bindings_installed_automatically"
      ],
      "properties": {
        "launch_helper_option": {
          "const": "programs.terminal-redeemer.slice.launchCommand"
        },
        "close_helper_option": {
          "const": "programs.terminal-redeemer.slice.closeFocusedCommand"
        },
        "manage_helper_option": {
          "const": "programs.terminal-redeemer.slice.manageCommand"
        },
        "generated_niri_option": {
          "const": "programs.terminal-redeemer.slice.niriIntegrationFragment"
        },
        "packaged_niri_path": {
          "const": "share/terminal-redeemer/host-leech-slices/v1/niri-bindings.kdl"
        },
        "launch_binding": {
          "const": "Mod+Return"
        },
        "close_binding": {
          "const": "Mod+W"
        },
        "bindings_installed_automatically": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zellij_shared_minimum_client_grid_reflow",
        "spatial_placement",
        "pinned_version_coupling",
        "ambiguous_transport_may_have_created_host_work",
        "routed_launch_process_correlation_can_remain_pending"
      ],
      "properties": {
        "zellij_shared_minimum_client_grid_reflow": {
          "const": true
        },
        "spatial_placement": {
          "const": "approximate_proportional_when_source_output_present"
        },
        "pinned_version_coupling": {
          "const": true
        },
        "ambiguous_transport_may_have_created_host_work": {
          "const": true
        },
        "routed_launch_process_correlation_can_remain_pending": {
          "const": true
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installs_niri_bindings",
        "legacy_attach_retained",
        "watch_supported",
        "automatic_local_fallback_after_remote_intent"
      ],
      "properties": {
        "installs_niri_bindings": {
          "const": false
        },
        "legacy_attach_retained": {
          "const": true
        },
        "watch_supported": {
          "const": false
        },
        "automatic_local_fallback_after_remote_intent": {
          "const": false
        }
      }
    },
    "future_work": {
      "const": [
        "exact_live_column_order",
        "multi_monitor_topology",
        "slice_clipboard_sync",
        "named_slices",
        "read_only_watch_projection"
      ]
    }
  }
}
